rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function owner() { return request.auth != null && request.auth.token.owner == true; }
  match /models/{uid}/{file} {
   allow read: if request.auth != null && (request.auth.uid == uid || owner());
   allow create: if request.auth != null && request.auth.uid == uid && file.matches('.*[.]stl') && request.resource.size > 0 && request.resource.size <= 50 * 1024 * 1024;
  }
  match /payment-qr/{file} {
   allow get: if request.auth != null;
   allow create: if owner() && request.resource.size <= 2 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg)');
  }
 }
}
